{
  "name": "NETAX 관리",
  "short_name": "NETAX",
  "start_url": "https://job.netax.kr/app/",
  "display": "standalone",
  "background_color": "#081226",
  "theme_color": "#0D1B3D",
  "icons": [
    {
      "src": "https://job.netax.kr/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "https://job.netax.kr/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "https://job.netax.kr/app/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "application/zip": [
          ".zip"
        ],
        "application/x-hwp": [
          ".hwp"
        ],
        "application/hwp+zip": [
          ".hwpx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
