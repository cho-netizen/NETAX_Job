 "해설서대조": [
  {
   "시기": "2017.8.3.~2018.8.27.",
   "해설서": "서울 25구, 과천·광명·성남·고양·남양주·하남·동탄2(주1), 부산 해운대·연제·동래·남·부산진·수영·기장군, 세종(예정지역)",
   "공고": "2017-1305호 같은 지역",
   "결과": "같음(시작일은 §154② — 거주요건)"
  },
  {
   "시기": "2018.8.28.~12.30.",
   "해설서": "+ 구리·안양 동안·광교택지(주2), 부산 기장군은 일광면만(주3)",
   "공고": "2018-1088·1089호",
   "결과": "같음"
  },
  {
   "시기": "2018.12.31.~2019.11.7.",
   "해설서": "+ 수원 팔달·용인 수지·기흥, 부산은 해운대·동래·수영만(주4)",
   "공고": "2018-1766·1767호",
   "결과": "같음"
  },
  {
   "시기": "2019.11.8.~2020.2.20.",
   "해설서": "고양 일부(주6 택지 제외 해제), 남양주 다산동·별내동(주7), 부산 전부 해제(주8)",
   "공고": "2019-1540호",
   "결과": "다름 → 공고 원문으로 고침: 5번 표가 남양주 예외를 '다산신도시·별내지구'(지구)로 적어 늘 '확인 필요'가 나왔음. 공고 원문 \"남양주시(다산동·별내동 제외)\" — 해설서와 같게 동 이름으로 고침"
  },
  {
   "시기": "2020.2.21. 이후",
   "해설서": "+ 수원 영통·권선·장안, 안양 만안, 의왕",
   "공고": "2020-197호",
   "결과": "같음"
  },
  {
   "시기": "2020.6.19. 이후",
   "해설서": "경기 전역(김포·파주·연천·동두천·포천·가평·양평·여주·이천·용인 처인 일부·광주 일부·남양주 화도·수동·조안·안성 일부 제외), 인천 전역(강화·옹진 제외), 대전, 청주(동 지역·오창·오송읍)",
   "공고": "2020-828·877호(지역을 하나씩 적음)",
   "결과": "같은 범위(해설서는 \"전역 − 제외\", 공고는 지역 나열)"
  },
  {
   "시기": "2020.11.20. 이후",
   "해설서": "+ 김포(통진읍·월곶·하성·대곶면 제외), 부산 해운대·수영·동래·연제·남구, 대구 수성구",
   "공고": "2020-1521호",
   "결과": "같음"
  },
  {
   "시기": "2020.12.18. 이후",
   "해설서": "+ 파주 동지역, 부산(기장군·중구 제외), 대구(달성군 일부 제외), 광주, 울산 중·남구, 천안·논산·공주·전주·창원 성산·포항 남·경산·여수·순천·광양(동지역 등), 인천 중구 을왕·남북·덕교·무의동·양주 백석·남·광적·은현·안성 일부 해제",
   "공고": "2020-1650호",
   "결과": "같음"
  },
