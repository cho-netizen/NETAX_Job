{
  "id": "/m/",
  "name": "NETAX job",
  "short_name": "NETAX job",
  "description": "job 바로 열기 · 다른 앱에서 공유한 파일을 job(드라이브)으로 받기",
  "start_url": "/m/?launch=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0D1B3D",
  "theme_color": "#0D1B3D",
  "icons": [
    { "src": "/m/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/m/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/m/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "받은 파일 사건에 넣기",
      "short_name": "받은 파일",
      "url": "/m/?inbox=1",
      "icons": [{ "src": "/m/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/m/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*", "video/*", "audio/*", "text/*", "application/*",
            ".pdf", ".hwp", ".hwpx", ".xlsx", ".xls", ".docx", ".doc", ".pptx", ".zip", ".csv", ".txt"
          ]
        }
      ]
    }
  }
}
